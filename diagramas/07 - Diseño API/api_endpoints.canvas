		{"id":"sub-auth-modelos","type":"group","x":-2920,"y":2120,"width":480,"height":525,"color":"3","label":"📦 Modelos"},
		{"id":"sub-auth-notas","type":"group","x":-2400,"y":2120,"width":480,"height":525,"label":"📝 Notas"},
		{"id":"sub-comp-modelos","type":"group","x":-480,"y":1750,"width":480,"height":505,"color":"3","label":"📦 Modelos"},
